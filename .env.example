# ==========================================
# Portal CROM — Variáveis de Ambiente (.env)
# ==========================================

# 1. Configurações Globais do Yii2
YII_DEBUG=1
YII_ENV=dev

# 2. Chave de Validação de Cookies (Mínimo 32 caracteres gerados de forma aleatória)
COOKIE_VALIDATION_KEY=insira_uma_chave_aleatoria_com_mais_de_32_caracteres

# 3. Conexão com o Banco de Dados (SQLite)
DB_DSN=sqlite:@app/data/core.db

# 4. Credenciais de Integração OAuth do GitHub App (Módulo Wiki)
GITHUB_CLIENT_ID=seu_client_id_aqui
GITHUB_CLIENT_SECRET=seu_client_secret_aqui
GITHUB_REDIRECT_URI=http://localhost:8080/wiki/auth/callback

# Chave simétrica para criptografar tokens no SQLite (Mínimo 32 caracteres aleatórios)
WIKI_SECRET_KEY=sua_chave_de_criptografia_simetrica_aqui
